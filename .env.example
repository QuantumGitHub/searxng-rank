# SearXNG
# Auto-discovery is the default: inside docker it uses the `searxng` service
# name; on the host it probes localhost:8080 / 8888. Set SEARXNG_BASE_URL to
# force a specific endpoint (overrides discovery).
# SEARXNG_BASE_URL=http://localhost:8080
SEARXNG_SERVICE_HOST=searxng
SEARXNG_SERVICE_PORT=8080
SEARXNG_SECRET_KEY=change-this-to-a-random-secret

# MCP server (Streamable HTTP)
MCP_HOST=0.0.0.0
MCP_PORT=8000

# LLM (OpenAI-compatible API) -- used by the orchestrator only, NOT the MCP
LLM_API_BASE=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.1:8b

# Qdrant (vector storage)
QDRANT_URL=http://localhost:6333

# Ranking
FLASHRANK_MODEL=ms-marco-TinyBERT-L-2-v2

# Max iterations for the search loop
MAX_ITERATIONS=3
QUALITY_THRESHOLD=0.7
